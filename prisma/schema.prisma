generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String

  level     Int      @default(1)
  xp        Int      @default(0)
  streak    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}